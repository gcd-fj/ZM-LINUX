+#[cfg(test)]
+mod bitmap_cache_regression {
+    use super::*;
+    #[derive(Debug)]
+    struct TestBitmap;
+    impl ruffle_render::bitmap::BitmapHandleImpl for TestBitmap {}
+
+    #[test]
+    fn hidden_animation_does_not_move_render_bounds() {
+        use crate::PlayerBuilder;
+        use crate::display_object::movie_clip::MovieClip;
+        use ruffle_render::shape_utils::DrawCommand;
+        let player = PlayerBuilder::new().build();
+        player
+            .lock()
+            .unwrap()
+            .mutate_with_update_context(|context| {
+                let mut parent = MovieClip::new(context.root_swf.clone(), context.gc());
+                let visible = MovieClip::new(context.root_swf.clone(), context.gc());
+                let hidden = MovieClip::new(context.root_swf.clone(), context.gc());
+                for clip in [visible, hidden] {
+                    let mut drawing = clip.drawing_mut();
+                    drawing.draw_command(DrawCommand::MoveTo(Point::new(Twips::ZERO, Twips::ZERO)));
+                    drawing.draw_command(DrawCommand::LineTo(Point::new(
+                        Twips::from_pixels_i32(40),
+                        Twips::from_pixels_i32(40),
+                    )));
+                }
+                parent.insert_at_index(context, visible.into(), 0);
+                parent.insert_at_index(context, hidden.into(), 1);
+                hidden.set_visible(context, false);
+                let matrix = Matrix::IDENTITY;
+                let expected = visible.render_bounds_with_transform(&matrix, false, &matrix, false);
+                for offset in [-201, -200, -199, 0, 200, 201] {
+                    hidden.set_matrix(Matrix {
+                        tx: Twips::new(offset),
+                        ty: Twips::new(offset),
+                        ..matrix
+                    });
+                    assert_eq!(
+                        parent.render_bounds_with_transform(&matrix, false, &matrix, false),
+                        expected
+                    );
+                }
+                assert_ne!(
+                    parent.render_bounds_with_transform(&matrix, false, &matrix, true),
+                    expected
+                );
+                hidden.set_visible(context, true);
+                assert_ne!(
+                    parent.render_bounds_with_transform(&matrix, false, &matrix, false),
+                    expected
+                );
+            });
+    }
+
+    #[test]
+    fn moving_bounds_origin_invalidates_same_size_cache() {
+        let matrix = Matrix::IDENTITY;
+        let origin = Point::new(Twips::ZERO, Twips::ZERO);
+        let cache = BitmapCache {
+            matrix_a: matrix.a,
+            matrix_b: matrix.b,
+            matrix_c: matrix.c,
+            matrix_d: matrix.d,
+            source_width: 64,
+            source_height: 64,
+            source_origin: origin,
+            bitmap: Some(BitmapInfo {
+                width: 64,
+                height: 64,
+                handle: BitmapHandle(std::sync::Arc::new(TestBitmap)),
+            }),
+            ..Default::default()
+        };
+        assert!(!cache.is_dirty(&matrix, 64, 64, origin));
+        // An invisible animated child can shift bounds without resizing them.
+        assert!(cache.is_dirty(&matrix, 64, 64, Point::new(Twips::new(1), Twips::ZERO)));
+        // Moving the whole object must still reuse its texture.
+        let translated = Matrix {
+            tx: Twips::from_pixels_i32(10),
+            ..matrix
+        };
+        assert!(!cache.is_dirty(&translated, 64, 64, origin));
+    }
+}
